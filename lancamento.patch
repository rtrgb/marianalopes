diff --git a/src/components/WorkList.astro b/src/components/WorkList.astro
index 447d97b..e89597d 100644
--- a/src/components/WorkList.astro
+++ b/src/components/WorkList.astro
@@ -15,9 +15,11 @@ const { lang, items } = Astro.props;
         <span class="title serif">{w.data.title}</span>
         <span class="cat">{w.data.category}</span>
         <span class="tag">{w.data.type}</span>
-        <span class="thumb">
-          {w.data.cover && <Image src={w.data.cover} alt="" widths={[200, 400]} sizes="160px" />}
-        </span>
+        {w.data.cover && (
+          <span class="thumb">
+            <Image src={w.data.cover} alt="" widths={[200, 400]} sizes="160px" />
+          </span>
+        )}
       </a>
     </li>
   ))}
diff --git a/src/views/ContentView.astro b/src/views/ContentView.astro
index 63e0415..250b5bd 100644
--- a/src/views/ContentView.astro
+++ b/src/views/ContentView.astro
@@ -8,7 +8,8 @@ import { getWork, getVideos } from '../lib/content';
 interface Props { lang: Lang }
 const { lang } = Astro.props;
 const work = await getWork(lang);
-const videos = await getVideos();
+// Só entram na grade os vídeos com arquivo ou link. Os outros aparecem quando ganharem um dos dois.
+const videos = (await getVideos()).filter((v) => v.data.video || v.data.link);
 ---
 
 <BaseLayout lang={lang} route="/content/" title={t(lang, 'nav.content')}>
