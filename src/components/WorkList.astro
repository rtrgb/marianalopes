---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { path, type Lang } from '../i18n/ui';

interface Props { lang: Lang; items: CollectionEntry<'work'>[] }
const { lang, items } = Astro.props;
---

<ol class="list">
  {items.map((w, i) => (
    <li>
      <a href={path(lang, `/work/${w.data.page}/`)} class="row">
        <span class="num serif">{String(i + 1).padStart(2, '0')}</span>
        <span class="title serif">{w.data.title}</span>
        <span class="cat">{w.data.category}</span>
        <span class="tag">{w.data.type}</span>
        {w.data.cover && (
          <span class="thumb">
            <Image src={w.data.cover} alt="" widths={[200, 400]} sizes="160px" />
          </span>
        )}
      </a>
    </li>
  ))}
</ol>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px 40px;
    padding: 32px 0; border-top: 1px solid var(--line);
  }
  .row:hover .title { color: var(--accent); }
  .num { flex: 0 0 48px; font-size: 20px; color: var(--muted); }
  .title { flex: 1 1 280px; min-width: 0; font-size: clamp(26px, 3vw, 34px); line-height: 1.15; transition: color 0.2s ease; color: var(--ink); }
  .cat { flex: 0 1 220px; font-size: 14px; color: var(--muted); }
  .tag {
    flex: 0 0 auto; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent); border: 1px solid var(--accent); padding: 4px 10px;
  }
  .thumb { flex: 0 0 160px; aspect-ratio: 4 / 3; background: var(--stone); overflow: hidden; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .row:hover .thumb :global(img) { transform: scale(1.04); }
  @media (max-width: 760px) { .thumb { display: none; } .num { flex-basis: 32px; } }
</style>
