---
// tem mp4 -> toca aqui, senao abre o post
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  video?: string;
  poster?: ImageMetadata;
  link?: string;
  label: string;
  placeholder: string;
  dark?: boolean;
}
const { video, poster, link, label, placeholder, dark = false } = Astro.props;
---

<div class:list={['frame', { dark }]}>
  {video ? (
    <video controls playsinline preload="metadata" aria-label={label} poster={poster?.src}>
      <source src={video} type="video/mp4" />
    </video>
  ) : (
    <a class="empty" href={link ?? '#'} target={link ? '_blank' : undefined} rel={link ? 'noopener' : undefined} aria-label={label}>
      {poster && <Image src={poster} alt="" widths={[360, 720]} sizes="(max-width: 760px) 100vw, 380px" class="poster" />}
      <svg aria-hidden="true" width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="28" cy="28" r="27"></circle><path d="M23 19l14 9-14 9z"></path>
      </svg>
      <span class="hint">{placeholder}</span>
    </a>
  )}
</div>

<style>
  .frame { aspect-ratio: 9 / 16; background: var(--stone); color: var(--muted); position: relative; overflow: hidden; }
  .frame.dark { background: var(--ink); color: var(--paper); }
  video { width: 100%; height: 100%; object-fit: cover; background: var(--ink); }
  .empty {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 14px; color: inherit;
  }
  .empty:hover { color: inherit; }
  .empty:hover svg { transform: scale(1.06); }
  svg { position: relative; transition: transform 0.3s ease; }
  .poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; }
  .hint { position: relative; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; }
</style>
