---
import type { CollectionEntry } from 'astro:content';
import VideoFrame from './VideoFrame.astro';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang; items: CollectionEntry<'videos'>[] }
const { lang, items } = Astro.props;
---

<ul class="grid">
  {items.map((v) => (
    <li class="item">
      <VideoFrame
        video={v.data.video}
        poster={v.data.poster}
        link={v.data.link}
        label={`${t(lang, 'more.watch')}: ${v.data.name}`}
        placeholder={v.data.link ? t(lang, 'more.watch') : t(lang, 'work.videoSoon')}
      />
      <span class="name serif">{v.data.name}</span>
      <span class="kind">{v.data.kind[lang]}</span>
    </li>
  ))}
</ul>

<style>
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 32px 20px;
  }
  .item { display: flex; flex-direction: column; gap: 4px; }
  .item :global(.frame) { margin-bottom: 10px; }
  .name { font-size: 20px; line-height: 1.2; }
  .kind { font-size: 13px; color: var(--muted); }
  @media (max-width: 480px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; } }
</style>
