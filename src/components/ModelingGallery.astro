---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang; items: CollectionEntry<'modeling'>[] }
const { lang, items } = Astro.props;

const categories = ['Editorial', 'Studio', 'Commercial'] as const;
const used = categories.filter((c) => items.some((i) => i.data.category === c));

// Versão grande de cada foto para a visualização ampliada.
const large = await Promise.all(items.map((i) => getImage({ src: i.data.src, width: 1600, format: 'webp' })));
---

<div class="gallery" data-gallery>
  <div class="filters" role="group" aria-label={t(lang, 'modeling.filter')}>
    <button type="button" data-filter="all" aria-pressed="true">{t(lang, 'modeling.all')}</button>
    {used.map((c) => (
      <button type="button" data-filter={c} aria-pressed="false">{t(lang, `cat.${c}`)}</button>
    ))}
  </div>

  <ul class="masonry">
    {items.map((item, i) => (
      <li data-cat={item.data.category}>
        <button type="button" class="open" data-index={i} data-full={large[i].src} data-alt={item.data.alt[lang]}>
          <Image
            src={item.data.src}
            alt={item.data.alt[lang]}
            widths={[400, 700, 1000]}
            sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 33vw"
            loading={i < 3 ? 'eager' : 'lazy'}
          />
        </button>
        <span class="cap">{t(lang, `cat.${item.data.category}`)}</span>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" aria-label="Photo">
    <img alt="" />
    <button type="button" class="lb-close" aria-label={t(lang, 'lightbox.close')}>&times;</button>
    <button type="button" class="lb-prev" aria-label={t(lang, 'lightbox.prev')}>&larr;</button>
    <button type="button" class="lb-next" aria-label={t(lang, 'lightbox.next')}>&rarr;</button>
  </dialog>
</div>

<style>
  .filters {
    display: flex; flex-wrap: wrap; gap: 4px 28px; padding: 8px 0; margin-bottom: 40px;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .filters button {
    background: none; border: 0; padding: 12px 0; min-height: 44px; cursor: pointer;
    font: inherit; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
  }
  .filters button[aria-pressed='true'] { color: var(--ink); box-shadow: inset 0 -1px 0 var(--ink); }

  .masonry { list-style: none; margin: 0; padding: 0; columns: 3 280px; column-gap: 20px; }
  .masonry li { break-inside: avoid; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px; }
  .masonry li[hidden] { display: none; }
  .open { display: block; padding: 0; border: 0; background: var(--stone); cursor: zoom-in; overflow: hidden; width: 100%; }
  .open :global(img) { width: 100%; height: auto; transition: transform 0.7s ease; }
  .open:hover :global(img) { transform: scale(1.03); }
  .cap { font-size: 12px; color: var(--muted); }

  .lightbox {
    width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: rgba(28, 26, 23, 0.96);
  }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: calc(100vw - 120px); max-height: calc(100vh - 80px); width: auto; height: auto; }
  .lightbox button {
    position: absolute; background: none; border: 0; color: var(--paper); cursor: pointer;
    font-size: 28px; width: 56px; height: 56px;
  }
  .lb-close { top: 12px; right: 12px; }
  .lb-prev { left: 8px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 8px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 600px) {
    .lightbox img { max-width: 100vw; max-height: calc(100vh - 140px); }
    .lb-prev, .lb-next { top: auto; bottom: 16px; transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const filters = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('.masonry li'));
    const dialog = root.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dialog.querySelector('img')!;
    let current = 0;

    filters.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((li) => (li.hidden = f !== 'all' && li.dataset.cat !== f));
      })
    );

    const visible = () => items.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLButtonElement>('.open')!);
    const show = (btn: HTMLButtonElement) => {
      img.src = btn.dataset.full!;
      img.alt = btn.dataset.alt ?? '';
      current = visible().indexOf(btn);
    };
    const step = (d: number) => {
      const list = visible();
      show(list[(current + d + list.length) % list.length]);
    };

    root.querySelectorAll<HTMLButtonElement>('.open').forEach((btn) =>
      btn.addEventListener('click', () => {
        show(btn);
        dialog.showModal();
      })
    );
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => step(-1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => step(1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  });
</script>
