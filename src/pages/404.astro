---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" route="/" title="Page not found">
  <section class="container" style="padding-block: 120px; display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
    <h1 class="serif" style="font-size: clamp(48px, 7vw, 96px); line-height: 1">Page not found</h1>
    <p>Página não encontrada.</p>
    <a href="/" class="link-underline">Home &rarr;</a>
  </section>
</BaseLayout>
