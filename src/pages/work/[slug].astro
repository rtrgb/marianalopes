---
import WorkView from '../../views/WorkView.astro';
import { getWork } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getWork('en');
  return items.map((entry) => ({ params: { slug: entry.data.page }, props: { entry } }));
}
const { entry } = Astro.props;
---
<WorkView lang="en" entry={entry} />
